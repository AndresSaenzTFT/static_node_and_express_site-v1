extends layout.pug

block content

  nav.nav
    a(href='/')
      span &larr;
      |  Back

  article.portfolio-projects
    .inner-wrapper.flex-row-wrap.two-col
      .project-info-box.box


        h1 #{title}

        p #{projectDesc}

      .project-tech-links-box.box
        h6 Technologies
        ul
         each tech in projectTech
          li= tech 

        a.btn-link(href=`${projectLive}`) Live Demo
        a.btn-link(href= `${proGitlink}`) GitHub Repo

    .project-img-box.box

      img.project-img(src= `/static/images/project${projectNo}.png`, alt=`${projectName}`)
      img.project-img(src= `/static/images/project${projectNo}-1.png`, alt=`${projectName}`)
      img.project-img(src= `/static/images/project${projectNo}-2.png`, alt=`${projectName}`)

    nav.nav
      a(href='/')
        span &larr;
        |  Back
